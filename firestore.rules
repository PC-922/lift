rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /profile/data {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /exercises/{exerciseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /routines/{routineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /metadata/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
